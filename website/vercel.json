{
  "functions": {
    "api/auth.js": { "maxDuration": 30 },
    "api/devices.js": { "maxDuration": 30 },
    "api/tasks.js": { "maxDuration": 30 },
    "api/recordings.js": { "maxDuration": 30 }
  },
  "routes": [
    { "src": "/api/(.*)", "dest": "/api/$1" },
    { "src": "/(.*)", "dest": "/$1" }
  ],
  "cleanUrls": true,
  "trailingSlash": false
}